@model ClinicaOdontologica.Models.Procedimento

@{
    ViewData["Title"] = "Editar procedimento";
}

<div class="container mt-4">
    <h2>Editar procedimento</h2>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome</label>
            <input asp-for="Nome" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Descricao" class="form-label">Descrição</label>
            <textarea asp-for="Descricao"
                      class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Valor" class="form-label">Valor (R$)</label>
            <input asp-for="Valor"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control"
                   required />
        </div>

        <button type="submit" class="btn btn-success">
            Salvar alterações
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Voltar
        </a>
    </form>
</div>
