@model ClinicaOdontologica.Models.Paciente

@{
    ViewData["Title"] = "Cadastrar paciente";
}

<div class="container mt-4">
    <h2>Cadastrar paciente</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome completo</label>
            <input asp-for="Nome" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Cpf" class="form-label">CPF</label>
            <input asp-for="Cpf" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Telefone" class="form-label">Telefone</label>
            <input asp-for="Telefone" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-success">
            Salvar paciente
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Voltar
        </a>
    </form>
</div>
