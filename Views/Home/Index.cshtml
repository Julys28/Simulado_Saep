@{
    ViewData["Title"] = "Página Inicial";
}

<h1>Painel Inicial</h1>

<p>Bem-vindo(a), @ViewBag.UsuarioNome!</p>

<div class="dashboard-grid">

    <div class="dashboard-card">
        <h3>Pacientes</h3>
        <p>Gerencie os pacientes cadastrados.</p>
        <a asp-controller="Pacientes" asp-action="Index">Acessar</a>
    </div>

    <div class="dashboard-card">
        <h3>Procedimentos</h3>
        <p>Consulte os procedimentos odontológicos.</p>
        <a asp-controller="Procedimentos" asp-action="Index">Acessar</a>
    </div>

    <div class="dashboard-card">
        <h3>Agendamentos</h3>
        <p>Consulte e organize os atendimentos.</p>
        <a asp-controller="Agendamentos" asp-action="Index">Acessar</a>
    </div>

</div>
